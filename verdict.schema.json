{
  "type": "object",
  "properties": {
    "scene_change": {
      "type": ["object", "null"],
      "description": "Observable first scene correction for tier critics; other critics may return null.",
      "properties": {
        "action": {"type": "string", "enum": ["move", "resize", "rotate", "add", "remove", "reshape"]},
        "subject": {"type": "string", "minLength": 1},
        "observed": {"type": "string", "minLength": 1},
        "desired": {"type": "string", "minLength": 1}
      },
      "required": ["action", "subject", "observed", "desired"],
      "additionalProperties": false
    },
    "score": {"type": "integer", "minimum": 0, "maximum": 10},
    "summary": {"type": "string"},
    "corrections": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "top_stage": {"type": "string"},
    "wrong_labels": {"type": "array", "items": {"type": "string"}},
    "missing_objects": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["scene_change", "score", "summary", "corrections", "top_stage", "wrong_labels", "missing_objects"],
  "additionalProperties": false
}
